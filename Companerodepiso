<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buscando compañero/a de piso - Lektionsmeny & App</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        .task-card { transition: all 0.2s ease-in-out; }
        .task-card:hover { transform: translateY(-3px); }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen text-slate-800 pb-12">

    <!-- TOP BAR / HEADER -->
    <header class="bg-indigo-800 text-white shadow-lg sticky top-0 z-30">
        <div class="max-w-4xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold flex items-center gap-2">
                    <i class="fa-solid fa-house-user text-indigo-300"></i> Buscando compañero/a de piso
                </h1>
                <p class="text-indigo-200 text-sm">Spanska 4 (B1) – Komplett Lektionsmeny (12 uppgifter)</p>
            </div>
            <!-- Elevprofil & Nollställning -->
            <div class="flex items-center gap-3">
                <input type="text" id="studentName" placeholder="Ditt namn..." class="px-3 py-1.5 rounded-lg text-slate-800 text-sm font-medium border-none focus:ring-2 focus:ring-indigo-300 outline-none shadow-inner" oninput="saveName()">
                <button onclick="resetProgress()" class="text-xs bg-indigo-900 hover:bg-indigo-950 text-indigo-200 px-2.5 py-1.5 rounded transition" title="Nollställ poäng">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 mt-6">

        <!-- PROGRESS & POÄNGBAR -->
        <section class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 mb-8">
            <div class="flex justify-between items-center mb-2">
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Din Progress</span>
                    <h2 class="text-2xl font-black text-slate-800 flex items-center gap-2">
                        <span id="scoreText">0</span> / 100 <span class="text-sm font-normal text-slate-500">poäng</span>
                    </h2>
                </div>
                <div id="badgeContainer" class="text-right">
                    <span id="statusBadge" class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1">
                        <i class="fa-solid fa-hourglass-start"></i> Börja samla poäng!
                    </span>
                </div>
            </div>

            <!-- Progress bar -->
            <div class="w-full bg-slate-100 rounded-full h-4 overflow-hidden shadow-inner border border-slate-200">
                <div id="progressBar" class="bg-gradient-to-r from-indigo-500 to-emerald-500 h-full w-0 transition-all duration-500 rounded-full"></div>
            </div>
            <p class="text-xs text-slate-500 mt-2">Samla minst <b>100 poäng</b> under vecka 1–3 för att bli redo för slutexaminationen (portfolio + muntlig intervju)!</p>
        </section>

        <!-- DASHBOARD UPPGIFTER -->
        <div class="space-y-6">

            <!-- 🟢 GRÖNA RÄTTER -->
            <div>
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 inline-block"></span>
                    <h3 class="font-bold text-lg text-slate-800">Gröna Rätter <span class="text-xs text-slate-500 font-normal">(Låg energi • Vocabulario, gramática y normas)</span></h3>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4" id="greenTasks"></div>
            </div>

            <!-- 🟡 GULA RÄTTER -->
            <div>
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-3.5 h-3.5 rounded-full bg-amber-500 inline-block"></span>
                    <h3 class="font-bold text-lg text-slate-800">Gula Rätter <span class="text-xs text-slate-500 font-normal">(Medelenergi • Lectura, anuncios, cartas y contratos)</span></h3>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4" id="yellowTasks"></div>
            </div>

            <!-- 🔴 RÖDA RÄTTER -->
            <div>
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-3.5 h-3.5 rounded-full bg-rose-500 inline-block"></span>
                    <h3 class="font-bold text-lg text-slate-800">Röda Rätter <span class="text-xs text-slate-500 font-normal">(Hög energi • Expresión oral, entrevistas y juegos de rol)</span></h3>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4" id="redTasks"></div>
            </div>

        </div>

    </main>

    <!-- INTERAKTIV MODAL FÖR ÖVNINGAR -->
    <div id="exerciseModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-slate-100 flex flex-col">
            <!-- Modal Header -->
            <div class="p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/80 rounded-t-2xl">
                <div>
                    <span id="modalCategory" class="text-xs font-bold px-2.5 py-0.5 rounded-full"></span>
                    <h2 id="modalTitle" class="text-xl font-bold text-slate-800 mt-1"></h2>
                </div>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 p-2 text-xl font-bold">&times;</button>
            </div>
            
            <!-- Modal Content Body -->
            <div id="modalBody" class="p-6 flex-1 space-y-4">
                <!-- Dynamiskt innehåll laddas in här -->
            </div>

            <!-- Modal Footer -->
            <div class="p-4 border-t border-slate-100 bg-slate-50/50 flex justify-end gap-3 rounded-b-2xl">
                <button onclick="closeModal()" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-200/60 rounded-xl transition">Stäng</button>
            </div>
        </div>
    </div>

    <script>
        const tasks = [
            // 🟢 GRÖNA
            { id: 'task1', color: 'green', points: 10, title: '1. Vocabulario', desc: 'Aprende vocabulario sobre vivienda, tareas y personalidad.', type: 'quiz_vocab' },
            { id: 'task2', color: 'green', points: 10, title: '2. Gramática', desc: 'Practica gustos, molestias y preferencias + 6 frases.', type: 'quiz_grammar' },
            { id: 'task3', color: 'green', points: 15, title: '3. Normas', desc: 'Practica reglas y obligaciones y formula 8 normas.', type: 'quiz_normas' },
            { id: 'task4', color: 'green', points: 10, title: '4. Responder a un anuncio', desc: 'Escribe una respuesta breve a un/a propietario/a.', type: 'short_reply' },
            
            // 🟡 GULA
            { id: 'task5', color: 'yellow', points: 20, title: '5. Lectura de anuncios', desc: 'Lee 3 anuncios de alquiler y responde preguntas.', type: 'reading_comp' },
            { id: 'task6', color: 'yellow', points: 25, title: '6. Mi anuncio', desc: 'Escribe tu propio anuncio o perfil (aprox 150 palabras).', type: 'ad_builder' },
            { id: 'task7', color: 'yellow', points: 25, title: '7. Carta al propietario', desc: 'Escribe un correo formal motivando tu candidatura.', type: 'formal_letter' },
            { id: 'task8', color: 'yellow', points: 25, title: '8. Contrato', desc: 'Crea un acuerdo escrito para un piso compartido.', type: 'contract_builder' },
            
            // 🔴 RÖDA
            { id: 'task9', color: 'red', points: 30, title: '9. Cuestionario', desc: 'Prepara 8 preguntas detalladas para la entrevista.', type: 'questionnaire' },
            { id: 'task10', color: 'red', points: 30, title: '10. Speed-dating', desc: 'Ejercicio oral en parejas con entrevistas de 3 min.', type: 'speed_dating' },
            { id: 'task11', color: 'red', points: 30, title: '11. Convencer al casero', desc: 'Simula una entrevista interactiva para convencer al casero.', type: 'landlord_chat' },
            { id: 'task12', color: 'red', points: 30, title: '12. Vídeo-presentación', desc: 'Graba o escribe el guion de tu vídeo (1.5-2 min).', type: 'video_script' }
        ];

        let state = { points: 0, completed: {}, studentName: '' };

        window.onload = () => { loadState(); renderTasks(); updateUI(); };

        function loadState() {
            const saved = localStorage.getItem('es_piso_v2_state');
            if (saved) {
                state = JSON.parse(saved);
                document.getElementById('studentName').value = state.studentName || '';
            }
        }

        function saveState() {
            localStorage.setItem('es_piso_v2_state', JSON.stringify(state));
        }

        function saveName() {
            state.studentName = document.getElementById('studentName').value;
            saveState();
        }

        function resetProgress() {
            if (confirm("Vill du nollställa alla dina poäng och resultat?")) {
                state.points = 0;
                state.completed = {};
                saveState();
                renderTasks();
                updateUI();
            }
        }

        function updateUI() {
            document.getElementById('scoreText').innerText = state.points;
            const percentage = Math.min(100, (state.points / 100) * 100);
            document.getElementById('progressBar').style.width = percentage + '%';

            const badge = document.getElementById('statusBadge');
            if (state.points >= 100) {
                badge.className = "bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1";
                badge.innerHTML = `<i class="fa-solid fa-trophy text-amber-500"></i> Redo för examination!`;
            } else if (state.points >= 50) {
                badge.className = "bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1";
                badge.innerHTML = `<i class="fa-solid fa-fire text-indigo-600"></i> Halvvägs där!`;
            } else {
                badge.className = "bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1";
                badge.innerHTML = `<i class="fa-solid fa-hourglass-start"></i> Börja samla poäng!`;
            }
        }

        function renderTasks() {
            const greenContainer = document.getElementById('greenTasks');
            const yellowContainer = document.getElementById('yellowTasks');
            const redContainer = document.getElementById('redTasks');

            greenContainer.innerHTML = ''; yellowContainer.innerHTML = ''; redContainer.innerHTML = '';

            tasks.forEach(task => {
                const isDone = state.completed[task.id];
                const card = document.createElement('div');
                card.className = `task-card bg-white p-4 rounded-xl border ${isDone ? 'border-emerald-300 bg-emerald-50/30' : 'border-slate-200'} shadow-sm flex flex-col justify-between`;
                let badgeColor = task.color === 'green' ? 'bg-emerald-100 text-emerald-800' : task.color === 'yellow' ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800';

                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <span class="${badgeColor} text-xs font-bold px-2 py-0.5 rounded-md">+${task.points} p</span>
                            ${isDone ? '<span class="text-emerald-600 font-bold text-xs flex items-center gap-1"><i class="fa-solid fa-circle-check"></i> Klar</span>' : ''}
                        </div>
                        <h4 class="font-bold text-slate-800 text-sm mb-1">${task.title}</h4>
                        <p class="text-xs text-slate-500 mb-3">${task.desc}</p>
                    </div>
                    <button onclick="openTask('${task.id}')" class="w-full text-center py-2 px-3 text-xs font-bold rounded-lg transition ${isDone ? 'bg-slate-100 text-slate-600 hover:bg-slate-200' : 'bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm'}">
                        ${isDone ? 'Gör om' : 'Starta'}
                    </button>
                `;

                if (task.color === 'green') greenContainer.appendChild(card);
                if (task.color === 'yellow') yellowContainer.appendChild(card);
                if (task.color === 'red') redContainer.appendChild(card);
            });
        }

        function openTask(taskId) {
            const task = tasks.find(t => t.id === taskId);
            if (!task) return;

            document.getElementById('modalTitle').innerText = task.title;
            const catBadge = document.getElementById('modalCategory');
            catBadge.innerText = `+${task.points} Poäng`;
            catBadge.className = `text-xs font-bold px-2.5 py-0.5 rounded-full ${task.color === 'green' ? 'bg-emerald-100 text-emerald-800' : task.color === 'yellow' ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800'}`;

            const modalBody = document.getElementById('modalBody');
            modalBody.innerHTML = '';

            switch(task.type) {
                case 'quiz_vocab': renderVocabQuiz(modalBody, task); break;
                case 'quiz_grammar': renderGrammarQuiz(modalBody, task); break;
                case 'quiz_normas': renderNormasQuiz(modalBody, task); break;
                case 'short_reply': renderShortReply(modalBody, task); break;
                case 'reading_comp': renderReadingComp(modalBody, task); break;
                case 'ad_builder': renderAdBuilder(modalBody, task); break;
                case 'formal_letter': renderFormalLetter(modalBody, task); break;
                case 'contract_builder': renderContractBuilder(modalBody, task); break;
                case 'questionnaire': renderQuestionnaire(modalBody, task); break;
                case 'speed_dating': renderSpeedDating(modalBody, task); break;
                case 'landlord_chat': renderLandlordChat(modalBody, task); break;
                case 'video_script': renderVideoScript(modalBody, task); break;
            }

            document.getElementById('exerciseModal').classList.remove('hidden');
        }

        function closeModal() { document.getElementById('exerciseModal').classList.add('hidden'); }

        function completeTask(taskId, points) {
            const isFirstTime = !state.completed[taskId];
            if (isFirstTime) {
                state.points += points;
                state.completed[taskId] = true;
                saveState();
                updateUI();
                renderTasks();
                confetti({ particleCount: 90, spread: 70, origin: { y: 0.6 } });
            }
            closeModal();
        }

        // -------------------------------------------------------------
        // IMPLEMENTATION AV ALLA 12 UPPGIFTER
        // -------------------------------------------------------------

        // 1. Vocabulario (10p)
        function renderVocabQuiz(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-3">Skriv exakt spansk glosa för följande 5 ord/fraser:</p>
                <div class="space-y-3 text-xs">
                    <div><span class="font-bold block">1. Hyra / Månadshyra = El _____</span><input type="text" id="vq1" placeholder="t.ex. alquiler" class="w-full p-2 border rounded"></div>
                    <div><span class="font-bold block">2. Diska = Fregar los _____</span><input type="text" id="vq2" placeholder="t.ex. platos" class="w-full p-2 border rounded"></div>
                    <div><span class="font-bold block">3. Deposition = La _____</span><input type="text" id="vq3" placeholder="t.ex. fianza" class="w-full p-2 border rounded"></div>
                    <div><span class="font-bold block">4. Dammsuga = Pasar la _____</span><input type="text" id="vq4" placeholder="t.ex. aspiradora" class="w-full p-2 border rounded"></div>
                    <div><span class="font-bold block">5. Sätta igång tvättmaskinen = Poner la _____</span><input type="text" id="vq5" placeholder="t.ex. lavadora" class="w-full p-2 border rounded"></div>
                    <button onclick="checkVocabQuiz('${task.id}', ${task.points})" class="w-full py-2.5 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Rätta vokabulär</button>
                    <p id="vqRes" class="text-xs font-bold text-rose-600 text-center hidden"></p>
                </div>
            `;
        }
        function checkVocabQuiz(taskId, points) {
            const v1 = document.getElementById('vq1').value.trim().toLowerCase();
            const v2 = document.getElementById('vq2').value.trim().toLowerCase();
            const v3 = document.getElementById('vq3').value.trim().toLowerCase();
            const v4 = document.getElementById('vq4').value.trim().toLowerCase();
            const v5 = document.getElementById('vq5').value.trim().toLowerCase();

            if (v1 === 'alquiler' && v2 === 'platos' && v3 === 'fianza' && v4 === 'aspiradora' && v5 === 'lavadora') {
                completeTask(taskId, points);
            } else {
                const res = document.getElementById('vqRes');
                res.innerText = "Något ord är felstavat. Kontrollera alla 5 svar!";
                res.classList.remove('hidden');
            }
        }

        // 2. Gramática (10p)
        function renderGrammarQuiz(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Välj rätt uttryck för vanor/preferenser, och skriv sedan <b>6 egna meningar</b> om dina vanor i hemmet:</p>
                <div class="space-y-2 text-xs mb-3">
                    <div class="p-2 bg-slate-50 border rounded">
                        <span>1. A mí me ________ los platos sucios en la cocina.</span>
                        <select id="gq1" class="w-full mt-1 p-1 border rounded"><option value="">Välj...</option><option value="correct">molestan</option><option value="wrong">molesta</option></select>
                    </div>
                    <div class="p-2 bg-slate-50 border rounded">
                        <span>2. Yo ________ estudiar en un ambiente tranquilo.</span>
                        <select id="gq2" class="w-full mt-1 p-1 border rounded"><option value="">Välj...</option><option value="correct">prefiero</option><option value="wrong">me prefiero</option></select>
                    </div>
                </div>
                <label class="font-bold text-xs block mb-1">Skriv 6 egna meningar (t.ex. <i>Suelo madrugar, Me molesta el ruido...</i>):</label>
                <textarea id="gText" rows="4" placeholder="1. Suelo acostarme temprano.&#10;2. Me molesta el desorden...&#10;3. Prefiero estudiar en mi habitación...&#10;4. No soporto los platos sucios...&#10;5. Me gusta cocinar el fin de semana...&#10;6. Para mí es importante la limpieza..." class="w-full p-2 border rounded text-xs mb-2"></textarea>
                <button onclick="checkGrammarTask('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Lämna in grammatik (+10p)</button>
                <p id="gRes" class="text-xs font-bold text-rose-600 text-center hidden mt-1"></p>
            `;
        }
        function checkGrammarTask(taskId, points) {
            const q1 = document.getElementById('gq1').value;
            const q2 = document.getElementById('gq2').value;
            const txt = document.getElementById('gText').value.trim();

            if (q1 === 'correct' && q2 === 'correct' && txt.length >= 80) {
                completeTask(taskId, points);
            } else {
                const res = document.getElementById('gRes');
                res.innerText = "Svara rätt på flervalsfrågorna och skriv minst 6 fylliga meningar (minst 80 tecken)!";
                res.classList.remove('hidden');
            }
        }

        // 3. Normas (15p)
        function renderNormasQuiz(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Formulera <b>8 ordningsregler</b> för ditt drömkollektiv med uttrycken <i>Hay que, Es obligatorio, Está prohibido, Se permite</i>:</p>
                <textarea id="normText" rows="6" placeholder="1. Hay que sacar la basura todos los días.&#10;2. Está prohibido fumar en las habitaciones.&#10;3. Es obligatorio fregar los platos después de comer.&#10;4. Se permite traer amigos los fines de semana...&#10;5. ...&#10;6. ...&#10;7. ...&#10;8. ..." class="w-full p-2 border rounded text-xs mb-2"></textarea>
                <button onclick="checkNormsTask('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Spara husregler (+15p)</button>
                <p id="normRes" class="text-xs font-bold text-rose-600 text-center hidden mt-1"></p>
            `;
        }
        function checkNormsTask(taskId, points) {
            const txt = document.getElementById('normText').value.trim();
            const hasHayQue = txt.toLowerCase().includes('hay que');
            const hasProhibido = txt.toLowerCase().includes('prohibido');

            if (txt.length >= 120 && hasHayQue && hasProhibido) {
                completeTask(taskId, points);
            } else {
                const res = document.getElementById('normRes');
                res.innerText = "Skriv minst 8 tydliga regler (minst 120 tecken) och använd 'Hay que' samt 'prohibido'!";
                res.classList.remove('hidden');
            }
        }

        // 4. Responder a un anuncio (10p)
        function renderShortReply(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Skriv ett kort svar till en hyresvärd/rumskamrat där du visar intresse för rummet (inkludera hälsning, hvem du är och varför du vill ha rummet):</p>
                <textarea id="replyText" rows="4" placeholder="Hola, he visto tu anuncio para la habitación. Me llamo Maria, tengo 20 años y estudio en la universidad. Estoy muy interesada en el piso porque..." class="w-full p-2 border rounded text-xs mb-2"></textarea>
                <button onclick="checkShortReply('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Skicka svar (+10p)</button>
                <p id="replyRes" class="text-xs font-bold text-rose-600 text-center hidden mt-1"></p>
            `;
        }
        function checkShortReply(taskId, points) {
            const txt = document.getElementById('replyText').value.trim().toLowerCase();
            const hasGreeting = txt.includes('hola') || txt.includes('buenas');
            const hasInterest = txt.includes('interesad') || txt.includes('me llamo') || txt.includes('habitación');

            if (txt.length >= 50 && hasGreeting && hasInterest) {
                completeTask(taskId, points);
            } else {
                const res = document.getElementById('replyRes');
                res.innerText = "Skriv minst 50 tecken och inkludera en hälsning samt varför du är intresserad!";
                res.classList.remove('hidden');
            }
        }

        // 5. Lectura de anuncios (20p)
        function renderReadingComp(container, task) {
            container.innerHTML = `
                <div class="bg-indigo-50 p-3 rounded-lg border border-indigo-200 text-xs text-slate-800 space-y-1.5 mb-3 max-h-40 overflow-y-auto">
                    <p class="font-bold text-indigo-900">Anuncio 1: Habitación en Valencia Centro (350€/mes, gastos no incluidos). Buscamos estudiante no fumador/a. No mascotas.</p>
                    <p class="font-bold text-indigo-900">Anuncio 2: Piso en Madrid - Malasaña (450€/mes, gastos incluidos). Ambiente festivo y sociable. Permitidas mascotas.</p>
                    <p class="font-bold text-indigo-900">Anuncio 3: Habitación para chicas en Barcelona (380€/mes, gastos incluidos). Piso muy tranquilo para concentrarse en el estudio.</p>
                </div>
                <div class="space-y-2 text-xs">
                    <div>
                        <label class="font-bold block mb-0.5">1. Vilket boende passar bäst för en rökfri student som vill ha lugn och ro i Valencia?</label>
                        <select id="rc1" class="w-full p-1.5 border rounded"><option value="">Välj...</option><option value="correct">Anuncio 1</option><option value="wrong">Anuncio 2</option></select>
                    </div>
                    <div>
                        <label class="font-bold block mb-0.5">2. I vilket boende ingår alla räkningar (gastos incluidos) OCH husdjur tillåts?</label>
                        <select id="rc2" class="w-full p-1.5 border rounded"><option value="">Välj...</option><option value="correct">Anuncio 2</option><option value="wrong">Anuncio 3</option></select>
                    </div>
                    <div>
                        <label class="font-bold block mb-0.5">3. Vilket boende är endast för tjejer i Barcelona?</label>
                        <select id="rc3" class="w-full p-1.5 border rounded"><option value="">Välj...</option><option value="correct">Anuncio 3</option><option value="wrong">Anuncio 1</option></select>
                    </div>
                    <button onclick="checkRC('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700 mt-2">Rätta läsförståelse</button>
                    <p id="rcRes" class="text-xs font-bold text-rose-600 text-center hidden mt-1"></p>
                </div>
            `;
        }
        function checkRC(taskId, points) {
            if (
                document.getElementById('rc1').value === 'correct' &&
                document.getElementById('rc2').value === 'correct' &&
                document.getElementById('rc3').value === 'correct'
            ) {
                completeTask(taskId, points);
            } else {
                const res = document.getElementById('rcRes');
                res.innerText = "Läs annonserna igen och kontrollera dina svar!";
                res.classList.remove('hidden');
            }
        }

        // 6. Mi anuncio (25p)
        function renderAdBuilder(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Skriv din egen sökannons eller profiltext (ca 100–150 ord). Beskriv din bakgrund, vanor, vad du söker hos boendet och dina kontaktuppgifter:</p>
                <textarea id="adText" rows="6" placeholder="¡Hola a todos! Me llamo Lucas, tengo 20 años y soy estudiante de economía. Busco una habitación luminosa en un piso compartido a partir de septiembre. Me considero una persona limpia, respetuosa y tranquila. En mi tiempo libre me gusta cocinar y hacer deporte. Busco compañeros sociables pero que respeten los momentos de estudio. Mi presupuesto máximo es de 400€ al mes..." class="w-full p-2.5 border rounded-lg text-xs mb-2"></textarea>
                <button onclick="submitAd('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Validera annons (+25p)</button>
                <p id="adErr" class="text-xs text-rose-600 font-bold hidden mt-1 text-center"></p>
            `;
        }
        function submitAd(taskId, points) {
            const txt = document.getElementById('adText').value.trim().toLowerCase();
            const err = document.getElementById('adErr');

            const hasBusco = txt.includes('busco');
            const hasSoy = txt.includes('soy') || txt.includes('me llamo');
            const hasQuality = txt.includes('limp') || txt.includes('ordenad') || txt.includes('tranquil');

            if (txt.length >= 150 && hasBusco && hasSoy && hasQuality) {
                completeTask(taskId, points);
            } else {
                err.innerText = "Texten måste vara fyllig (minst 150 tecken) och innehålla information om vem du är, vad du söker och dina egenskaper!";
                err.classList.remove('hidden');
            }
        }

        // 7. Carta al propietario (25p)
        function renderFormalLetter(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Skriv ett formellt mejl till en hyresvärd/ägare där du motiverar varför du är den perfekta hyresgästen (använd formellt språk: <i>Estimado/a Sr./Sra., Me dirijo a usted..., Atentamente</i>):</p>
                <textarea id="letterText" rows="6" placeholder="Estimado/a Sr. Rodríguez:&#10;&#10;Me dirijo a usted para presentar mi candidatura para la habitación anunciada...&#10;Soy una persona responsable, puntual con los pagos y no fumadora...&#10;&#10;Quedo a su disposición para realizar una entrevista.&#10;&#10;Atentamente,&#10;[Tu nombre]" class="w-full p-2.5 border rounded-lg text-xs mb-2"></textarea>
                <button onclick="submitFormalLetter('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Skicka formellt mejl (+25p)</button>
                <p id="letterErr" class="text-xs text-rose-600 font-bold hidden mt-1 text-center"></p>
            `;
        }
        function submitFormalLetter(taskId, points) {
            const txt = document.getElementById('letterText').value.trim().toLowerCase();
            const err = document.getElementById('letterErr');

            const hasFormalGreeting = txt.includes('estimad') || txt.includes('dirijo a usted');
            const hasFormalClosing = txt.includes('atentamente') || txt.includes('un cordial saludo');

            if (txt.length >= 120 && hasFormalGreeting && hasFormalClosing) {
                completeTask(taskId, points);
            } else {
                err.innerText = "Skriv minst 120 tecken och använd formella fraser som 'Estimado/a', 'Me dirijo a usted' och 'Atentamente'!";
                err.classList.remove('hidden');
            }
        }

        // 8. Contrato (25p)
        function renderContractBuilder(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Skapa ett skriftligt samlevnadskontrakt (<i>Contrato de convivencia</i>). Inkludera sektioner för: <i>Limpieza, Gastos, Fiestas/Visitas</i> och <i>Horarios</i>:</p>
                <textarea id="contractText" rows="6" placeholder="ACUERDO Y CONTRATO DE CONVIVENCIA&#10;1. Limpieza: Es obligatorio organizar los turnos de limpieza semanalmente...&#10;2. Gastos: Los gastos de agua, luz e internet se dividen a partes iguales...&#10;3. Fiestas y visitas: Está prohibido hacer fiestas los días laborables...&#10;4. Horarios: Se exige silencio a partir de las 22:00..." class="w-full p-2.5 border rounded-lg text-xs mb-2"></textarea>
                <button onclick="submitContract('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Validera kontrakt (+25p)</button>
                <p id="contractErr" class="text-xs text-rose-600 font-bold hidden mt-1 text-center"></p>
            `;
        }
        function submitContract(taskId, points) {
            const txt = document.getElementById('contractText').value.trim().toLowerCase();
            const err = document.getElementById('contractErr');

            const hasLimpieza = txt.includes('limpieza');
            const hasGastos = txt.includes('gastos');
            const hasNorm = txt.includes('prohibido') || txt.includes('obligatorio') || txt.includes('horario');

            if (txt.length >= 120 && hasLimpieza && hasGastos && hasNorm) {
                completeTask(taskId, points);
            } else {
                err.innerText = "Kontraktet måste vara fylligt (minst 120 tecken) och täcka både 'limpieza', 'gastos' och regler!";
                err.classList.remove('hidden');
            }
        }

        // 9. Cuestionario (30p)
        function renderQuestionnaire(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Förbered <b>8 detaljerade intervjufrågor</b> på spanska till en potentiell rumskamrat:</p>
                <textarea id="questText" rows="6" placeholder="1. ¿Cómo te organizas con la limpieza de las zonas comunes?&#10;2. ¿Sueles madrugar o acostarte tarde?&#10;3. ¿Qué opinas sobre traer visitas al piso?&#10;4. ¿Fumas o tienes mascotas?&#10;5. ¿Cómo compartimos la compra de productos comunes?&#10;6. ¿Tienes experiencia previa viviendo en piso compartido?&#10;7. ¿Qué haces si hay un conflicto de convivencia?&#10;8. ¿Estudias o trabajas actualmente?" class="w-full p-2.5 border rounded-lg text-xs mb-2"></textarea>
                <button onclick="submitQuest('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Validera frågebank (+30p)</button>
                <p id="questErr" class="text-xs text-rose-600 font-bold hidden mt-1 text-center"></p>
            `;
        }
        function submitQuest(taskId, points) {
            const txt = document.getElementById('questText').value.trim();
            const err = document.getElementById('questErr');
            const hasQuestions = txt.includes('?') || txt.includes('¿');

            if (txt.length >= 120 && hasQuestions) {
                completeTask(taskId, points);
            } else {
                err.innerText = "Förbered 8 ordentliga frågor med frågetecken (minst 120 tecken totalt)!";
                err.classList.remove('hidden');
            }
        }

        // 10. Speed-dating (30p)
        function renderSpeedDating(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Muntlig övning i par! Genomför korta 3-minuters intervjuer där ni byter roller (hyresvärd vs sökande). Anteckna din partners namn och 3 saker du lärde dig om deras vanor:</p>
                <input type="text" id="partnerName" placeholder="Partnerns namn..." class="w-full p-2 border rounded text-xs mb-2">
                <textarea id="sdNotes" rows="4" placeholder="Min partner brukar madrugar, gillar ordning i köket och har inga husdjur..." class="w-full p-2 border rounded text-xs mb-2"></textarea>
                <button onclick="submitSpeedDating('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Spara speed-dating anteckningar (+30p)</button>
                <p id="sdErr" class="text-xs text-rose-600 font-bold hidden mt-1 text-center"></p>
            `;
        }
        function submitSpeedDating(taskId, points) {
            const partner = document.getElementById('partnerName').value.trim();
            const notes = document.getElementById('sdNotes').value.trim();
            const err = document.getElementById('sdErr');

            if (partner.length >= 2 && notes.length >= 40) {
                completeTask(taskId, points);
            } else {
                err.innerText = "Ange din partners namn och skriv minst 40 tecken om er intervju!";
                err.classList.remove('hidden');
            }
        }

        // 11. Convencer al casero (30p)
        function renderLandlordChat(container, task) {
            container.innerHTML = `
                <div class="bg-slate-100 p-3 rounded-xl border border-slate-200 h-52 overflow-y-auto space-y-2 text-xs" id="chatBox">
                    <div class="bg-indigo-700 text-white p-2.5 rounded-lg max-w-[85%]">
                        <b>Sr. Martínez (Casero):</b> Hola. Tengo muchos candidatos para esta habitación. ¿Por qué debería elegirte a ti y no a otra persona?
                    </div>
                </div>
                <div class="mt-3 space-y-2 text-xs" id="chatOptions">
                    <button onclick="sendLandlordChat('Hola Sr. Martínez. Soy un candidato ideal porque soy puntual con el pago, no fumo y cuido mucho el piso.', 1)" class="w-full text-left p-2.5 bg-white border border-slate-300 rounded-lg hover:bg-indigo-50 font-medium">
                        A: "Hola Sr. Martínez. Soy un candidato ideal porque soy puntual con el pago, no fumo y cuido mucho el piso."
                    </button>
                    <button onclick="sendLandlordChat('Bueno, no sé, necesito un sitio para dormir.', 0)" class="w-full text-left p-2.5 bg-white border border-slate-300 rounded-lg hover:bg-indigo-50 font-medium">
                        B: "Bueno, no sé, necesito un sitio para dormir."
                    </button>
                </div>
            `;
            window.currentTask = task;
        }
        function sendLandlordChat(text, step) {
            const chatBox = document.getElementById('chatBox');
            chatBox.innerHTML += `<div class="bg-emerald-600 text-white p-2.5 rounded-lg max-w-[85%] ml-auto">${text}</div>`;

            if (step === 0) {
                setTimeout(() => {
                    chatBox.innerHTML += `<div class="bg-rose-600 text-white p-2.5 rounded-lg max-w-[85%]"><b>Sr. Martínez:</b> Esa respuesta no me da confianza. Inténtalo de nuevo.</div>`;
                    chatBox.scrollTop = chatBox.scrollHeight;
                }, 400);
                return;
            }

            setTimeout(() => {
                if (step === 1) {
                    chatBox.innerHTML += `<div class="bg-indigo-700 text-white p-2.5 rounded-lg max-w-[85%]"><b>Sr. Martínez:</b> Suena bien. ¿Tienes ingresos estables o aval para garantizar el pago del alquiler?</div>`;
                    document.getElementById('chatOptions').innerHTML = `
                        <button onclick="sendLandlordChat('Sí, tengo una beca universitaria y ayuda familiar. Puedo pagar la fianza sin problemas.', 2)" class="w-full text-left p-2.5 bg-white border border-slate-300 rounded-lg hover:bg-indigo-50 font-medium">
                            A: "Sí, tengo una beca universitaria y ayuda familiar. Puedo pagar la fianza sin problemas."
                        </button>
                    `;
                } else if (step === 2) {
                    chatBox.innerHTML += `<div class="bg-indigo-700 text-white p-2.5 rounded-lg max-w-[85%]"><b>Sr. Martínez:</b> Perfecto. Me parece que eres una persona responsable. ¡El piso es tuyo!</div>`;
                    document.getElementById('chatOptions').innerHTML = `
                        <button onclick="completeTask('${window.currentTask.id}', ${window.currentTask.points})" class="w-full p-3 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700 shadow-md">
                            Övertyga hyresvärden slutfört! (+30p)
                        </button>
                    `;
                }
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 600);
        }

        // 12. Vídeo-presentación (30p)
        function renderVideoScript(container, task) {
            container.innerHTML = `
                <p class="text-sm text-slate-600 mb-2">Skriv manuset till din videopresentation (1.5–2 minuter). Berätta om din livsstil, dina vanor i hemmet och varför någon borde välja dig som rumskamrat (minst 120 tecken):</p>
                <textarea id="videoScriptText" rows="6" placeholder="¡Hola a todos! En este vídeo me presento para encontrar piso...&#10;Mi día a día empieza temprano porque me gusta madrugar...&#10;En casa me gusta mantener todo limpio y compartir momentos tranquilos con mis compañeros...&#10;Si buscas a alguien responsable y simpático, ¡contáctame!" class="w-full p-2.5 border rounded-lg text-xs mb-2"></textarea>
                <button onclick="submitVideoScript('${task.id}', ${task.points})" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700">Validera videomanus (+30p)</button>
                <p id="videoErr" class="text-xs text-rose-600 font-bold hidden mt-1 text-center"></p>
            `;
        }
        function submitVideoScript(taskId, points) {
            const txt = document.getElementById('videoScriptText').value.trim().toLowerCase();
            const err = document.getElementById('videoErr');

            if (txt.length >= 120) {
                completeTask(taskId, points);
            } else {
                err.innerText = "Manuset måste vara fylligt och täcka din livsstil (minst 120 tecken)!";
                err.classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
